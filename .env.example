# ─────────────────────────────────────────────────────────────
# .env.example — bmad-encar-demo 환경변수 견본 (값 없이 키만 문서화)
#
# 이 파일은 "어떤 환경변수가 필요한지" 알려주는 견본입니다(git에 올림, 비밀값 없음).
# 실제 값은 각 앱 폴더의 .env 파일에 넣으며, 그 파일들은 .gitignore로 보호됩니다.
#
# ⚠️ 배치 규칙
#   - web/.env.local  → 브라우저로 전달되는 값만. 반드시 NEXT_PUBLIC_ 접두사.
#   - api/.env        → 서버 전용. Gemini 키는 여기에만! (웹에 절대 넣지 않음)
#   - app/.env        → Flutter 앱(Epic 7, 나중)
#   anon key는 RLS가 보호하므로 클라이언트 노출 안전. service_role 키는 사용하지 않음.
# ─────────────────────────────────────────────────────────────

# ===== web/.env.local (사용자·관리자 웹 / Next.js) =====
# 브라우저로 전달되어야 하므로 NEXT_PUBLIC_ 접두사 필수
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== api/.env (AI 백엔드 / FastAPI + LangGraph) =====
# 서버 전용 — 외부로 노출되지 않음
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 읽기전용 DB 직결 — 대시보드 > Connect > "Transaction pooler" 문자열 그대로.
#   postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   ⚠️ 포트 6543(Transaction pooler, AC-DB-1) 권장. SET LOCAL ROLE은 풀러와 무관하게 Postgres가
#   트랜잭션 스코프로 격리해 안전은 보장되고, 6543은 풀이 의도한 트랜잭션 단위 재사용 성능을 살린다.
DATABASE_URL=
# Gemini API 키 — ⚠️ 오직 여기(api)에만 둔다. 웹에는 넣지 않는다.
GEMINI_API_KEY=
# 임베딩 차원 — pgvector vector(768)과 반드시 일치 (불일치 시 AI 검색 미동작)
GEMINI_EMBEDDING_DIM=768
# 모델 ID — 명시 버전 고정 권장(별칭 *-latest는 자동으로 최신·고가 모델로 흐를 수 있음).
# 데모 기준 후보: gemini-3.1-flash-lite(권장)·gemini-2.5-flash-lite(최저가)
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# LangSmith 트레이싱(선택, FR51) — ⚠️ 이 두 값은 **프로세스 환경변수로 노출돼야** 켜진다.
# 파일에 적어 두기만 하면 꺼진 상태다: config.py의 Settings는 이 키를 모르고(선언 필드가
# 아니라 extra="ignore"로 조용히 버려짐) langsmith SDK가 os.environ을 직접 읽는다.
#   set -a; source api/.env; set +a   ← 이걸 하고 서버/스크립트를 띄워야 계측이 붙는다
# 노출되고 나면 앱 코드 변경 없이 langchain-core/langgraph가 전역 계측을 자동으로 켠다.
# ⚠️ LANGCHAIN_TRACING_V2는 정확히 소문자 문자열 "true"만 켜진다(langsmith SDK 실측 확인) —
#   "1"·"True"·"yes"는 물론 후행 공백("true ")·인라인 주석("true # 메모")도 에러 없이 조용히
#   꺼진 상태로 남는다(source가 그 문자열을 값에 통째로 싣는다).
# ⚠️ 두 값은 함께 채워야 한다 — TRACING_V2만 true이고 API_KEY가 비어 있으면 "켜진 것처럼"
#   보이지만(SDK가 API_KEY 유무를 미리 확인하지 않음) 실제로는 트레이스가 하나도 기록되지 않는다.
# ⚠️ LANGSMITH_* 와 섞이면 해석 순서는 **접미사 우선, 그 안에서 네임스페이스**다(실측 확인):
#   TRACING_V2 자리를 먼저 보고, 거기가 비어 있을 때만 TRACING 자리로 내려간다. 같은 자리
#   안에서만 LANGSMITH_ 가 LANGCHAIN_ 를 이긴다. 그래서:
#     · 여기 LANGCHAIN_TRACING_V2에 값이 남아 있으면(false든 오타 "true "든) 셸의
#       LANGSMITH_TRACING=true를 **덮어서 끈다** — 안 쓸 거면 반드시 비워 둬라.
#     · API_KEY는 자리가 하나뿐이라 셸의 LANGSMITH_API_KEY가 있으면 여기 채운 값은 무시된 채
#       남의 워크스페이스로 전송된다.
#   이 규칙은 api/tests/test_langsmith_env_contract.py가 CI에서 실제로 검사한다.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=

# ===== app/.env (Flutter 모바일 앱 / Epic 7, 나중에 사용) =====
# SUPABASE_URL / SUPABASE_ANON_KEY 는 위와 동일한 값 사용
# API_BASE_URL 은 FastAPI(api) 서버 주소 (예: http://10.0.2.2:8000 — 안드로이드 에뮬레이터)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# API_BASE_URL=
