# api/.env.example — AI 백엔드 전용 환경변수 견본 (값 없이 키만 문서화)
# 실제 값은 api/.env 에 넣는다(.gitignore로 보호). 루트 .env.example의 api 섹션과 동일하게 유지.

# ── Supabase ── JWT 검증(auth.get_user)에 사용. web/.env.local과 같은 프로젝트 값.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── 읽기전용 DB 직결 ── 대시보드 > Connect > "Transaction pooler" 문자열을 그대로 사용.
#   형식: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   ⚠️ 포트 6543(Transaction pooler, AC-DB-1) 권장(Story 8.4). readonly.py가 매 쿼리를
#   BEGIN;SET LOCAL ROLE ai_readonly;...;COMMIT;으로 감싸는데, 이는 풀러 종류와 무관하게
#   Postgres 자체가 트랜잭션 스코프로 격리하므로 안전 — 6543은 풀의 트랜잭션 단위 재사용 성능을 위함이다.
DATABASE_URL=

# ── Gemini ── 4.2(임베딩)·4.3+(LLM)에서 사용. 4.1에서는 미사용(키 비워도 기동됨).
GEMINI_API_KEY=
GEMINI_EMBEDDING_DIM=768
# 명시 버전 고정 권장(별칭 *-latest는 자동으로 최신·고가 모델로 흐를 수 있음). 데모 기준 후보: gemini-3.1-flash-lite(권장)·gemini-2.5-flash-lite(최저가)
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── 리랭커 사이드카(선택, 4단계 부품 A) ──
#   scripts/dev-reranker.sh로 띄운 독립 GPU 프로세스 주소. 예: http://127.0.0.1:8801
#   미설정이면 app/rerank_client.py가 항상 None을 돌려주고 호출부는 기존 순서를 유지한다.
RERANKER_URL=

# ── LangSmith 트레이싱(선택, FR51) ──
#   ⚠️ 이 두 값은 **프로세스 환경변수로 노출돼야** 켜진다. 파일에 적어 두기만 하면 꺼진
#   상태다: config.py의 Settings는 이 키를 모르고(선언 필드가 아니라 extra="ignore"로 조용히
#   버려짐) langsmith SDK가 os.environ을 직접 읽는다.
#     set -a; source .env; set +a   ← 이걸 하고 서버/스크립트를 띄워야 계측이 붙는다
#   노출되고 나면 앱 코드 변경 없이 langchain-core/langgraph가 전역 계측을 자동으로 켠다.
#   ⚠️ LANGCHAIN_TRACING_V2는 정확히 소문자 문자열 "true"만 켜진다(langsmith SDK 실측 확인) —
#     "1"·"True"·"yes"는 물론 후행 공백("true ")·인라인 주석("true # 메모")도 에러 없이 조용히
#     꺼진 상태로 남는다(source가 그 문자열을 값에 통째로 싣는다).
#   ⚠️ 두 값은 함께 채워야 한다 — TRACING_V2만 true이고 API_KEY가 비어 있으면 "켜진 것처럼"
#     보이지만(SDK가 API_KEY 유무를 미리 확인하지 않음) 실제로는 트레이스가 하나도 기록되지 않는다.
#   ⚠️ LANGSMITH_* 와 섞이면 해석 순서는 **접미사 우선, 그 안에서 네임스페이스**다(실측 확인):
#     TRACING_V2 자리를 먼저 보고, 거기가 비어 있을 때만 TRACING 자리로 내려간다. 같은 자리
#     안에서만 LANGSMITH_ 가 LANGCHAIN_ 를 이긴다. 그래서:
#       · 여기 LANGCHAIN_TRACING_V2에 값이 남아 있으면(false든 오타 "true "든) 셸의
#         LANGSMITH_TRACING=true를 **덮어서 끈다** — 안 쓸 거면 반드시 비워 둬라.
#       · API_KEY는 자리가 하나뿐이라 셸의 LANGSMITH_API_KEY가 있으면 여기 채운 값은 무시된 채
#         남의 워크스페이스로 전송된다.
#     이 규칙은 tests/test_langsmith_env_contract.py가 CI에서 실제로 검사한다.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=

# ── CORS 허용 오리진(웹) ──
#   CORS_ORIGINS: 정확히 일치할 오리진(쉼표 구분). 운영 도메인·localhost 등.
#   CORS_ORIGIN_REGEX(선택): preview처럼 매번 바뀌는 오리진을 정규식으로 허용. 개발 서버용.
#     예) ^https://bmad-encar-demo-.*\.vercel\.app$   (미설정이면 정확 매칭만 사용)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
